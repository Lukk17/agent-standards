#!/bin/sh
# run: the quality loop wrapper around Robert C. Martin's crapper, dryer and mutator, for Linux and macOS.
# Usage: .metrics/tools/run measure | mutate [--changed] | summary [--limit N]
# Exit codes: 0 done, 1 a tool or a setup step failed, 2 usage error or no Python 3.11, 3 a mutant survived.
# Needs Python 3.11 or newer on PATH as python3 or python. POSIX sh, no bash features.
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 \
    && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    exec "$candidate" "$here/run.py" "$@"
  fi
done

echo "quality-loop: needs Python 3.11 or newer on PATH as python3 or python." >&2
exit 2
