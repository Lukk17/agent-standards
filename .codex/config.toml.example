# Codex CLI + IDE project-scoped MCP servers. Copy to .codex/config.toml.
# Codex has no env-var substitution here; edit URLs and paste tokens directly,
# or wrap a command in a script that reads from your secrets manager.

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp@latest"]

[mcp_servers.mongodb]
command = "npx"
args = [
    "-y",
    "mongodb-mcp-server@latest",
    "--readOnly",
    "--connectionString",
    "mongodb://localhost:27017",
]

[mcp_servers.grafana]
command = "uvx"
args = ["mcp-grafana"]
env = { GRAFANA_URL = "http://localhost:3000", GRAFANA_SERVICE_ACCOUNT_TOKEN = "" }

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

[mcp_servers.chrome-devtools]
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest"]

[mcp_servers.redis]
command = "uvx"
args = [
    "--from",
    "redis-mcp-server@latest",
    "redis-mcp-server",
    "--url",
    "redis://localhost:6379/0",
]

[mcp_servers.sonarqube]
command = "docker"
args = [
    "run",
    "--init",
    "--pull=always",
    "-i",
    "--rm",
    "-e",
    "SONARQUBE_TOKEN",
    "-e",
    "SONARQUBE_URL",
    "mcp/sonarqube",
]
env = { SONARQUBE_TOKEN = "", SONARQUBE_URL = "http://localhost:9000" }

[mcp_servers.n8n]
command = "npx"
args = ["n8n-mcp"]
env = { N8N_API_URL = "http://localhost:5678", N8N_API_KEY = "" }
