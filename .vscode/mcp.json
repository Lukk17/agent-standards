{
  "servers": {

    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },

    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@3.3.0",
        "--readOnly",
        "--connectionString",
        "mongodb://localhost:27017"
      ]
    },

    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana==2.2.0"
      ],
      "env": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },

    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.85"
      ]
    },

    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0"
      ]
    },

    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server==0.5.1",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    },

    "sonarqube": {
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "mcp/sonarqube@sha256:925c88bc7cab2a1e1025b0bd43f0af504cd8ce1b99e9663ececaca914fb632e7"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${env:SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "http://localhost:9000"
      }
    },

    "n8n": {
      "command": "npx",
      "args": [
        "n8n-mcp@2.102.0"
      ],
      "env": {
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "${env:N8N_API_KEY}"
      }
    },

    "home-assistant": {
      "command": "uvx",
      "args": [
        "--env-file",
        "${userHome}/.local/state/agents/workspace/homelab.env",
        "ha-mcp==8.7.0"
      ]
    }
  }
}
