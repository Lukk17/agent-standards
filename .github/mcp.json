{
  "mcpServers": {

    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },

    "mongodb": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@3.3.0",
        "--readOnly",
        "--connectionString",
        "mongodb://localhost:27017"
      ]
    },

    "grafana": {
      "type": "local",
      "command": "uvx",
      "args": [
        "mcp-grafana==2.2.0"
      ],
      "env": {
        "GRAFANA_URL": "http://localhost:3000"
      }
    },

    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.85"
      ]
    },

    "chrome-devtools": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0"
      ]
    },

    "redis": {
      "type": "local",
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server==0.5.1",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    },

    "sonarqube": {
      "type": "local",
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "sonarsource/sonarqube-mcp:1.32.0.5118"
      ],
      "env": {
        "SONARQUBE_URL": "http://localhost:9000"
      }
    },

    "n8n": {
      "type": "local",
      "command": "npx",
      "args": [
        "n8n-mcp@2.102.0"
      ],
      "env": {
        "N8N_API_URL": "http://localhost:5678"
      }
    }
  }
}
