{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "edit": "allow",
    "bash": "allow",
    "read": "allow"
  },
  "instructions": [
    "AGENTS.md",
    ".agents/instructions/reply-rules.md"
  ],
  "plugin": [
    "./.agents/plugin"
  ],
  "mcp": {
    
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },

    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    },
    
    "mongodb": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mongodb-mcp-server@3.3.0",
        "--readOnly",
        "--connectionString",
        "mongodb://localhost:27017"
      ],
      "enabled": true
    },
    
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana==2.2.0"
      ],
      "environment": {
        "GRAFANA_URL": "http://localhost:3000"
      },
      "enabled": true
    },
    
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@0.0.85"
      ],
      "enabled": true
    },
    
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.13.0"
      ],
      "enabled": true
    },
    
    "redis": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "redis-mcp-server==0.5.1",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ],
      "enabled": true
    },
    
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "sonarsource/sonarqube-mcp:1.32.0.5118"
      ],
      "environment": {
        "SONARQUBE_URL": "http://localhost:9000"
      },
      "enabled": true
    },
    
    "n8n": {
      "type": "local",
      "command": [
        "npx",
        "n8n-mcp@2.102.0"
      ],
      "environment": {
        "N8N_API_URL": "http://localhost:5678"
      },
      "enabled": true
    }
  }
}
